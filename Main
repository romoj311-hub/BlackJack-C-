#include <iostream>
#include "Player.h"
#include "Dealer.h"
using namespace std;

int main()
{
    cout << "========================================" << endl;
    cout << "     TESTING PLAYER AND DEALER CLASSES" << endl;
    cout << "========================================" << endl << endl;

    // Test 1: Player Constructor
    cout << "TEST 1: Player Constructor" << endl;
    cout << "Creating a player named 'John'" << endl;
    Player player("John");
    cout << "Player name: " << player.getName() << endl << endl;

    // Test 2: Default Player Constructor
    cout << "TEST 2: Default Player Constructor" << endl;
    Player defaultPlayer;
    cout << "Default player name: " << defaultPlayer.getName() << endl << endl;

    // Test 3: Add Cards to Player
    cout << "TEST 3: Adding Cards to Player" << endl;
    player.addCard(5);
    player.addCard(10);
    player.addCard(8);
    cout << "Added cards: 5, 10, 8" << endl;
    player.showHand();
    cout << endl;

    // Test 4: Get Hand Value
    cout << "TEST 4: Get Hand Value" << endl;
    cout << "Hand value: " << player.getHandValue() << endl << endl;

    // Test 5: setName
    cout << "TEST 5: Set Player Name" << endl;
    player.setName("Alice");
    cout << "New player name: " << player.getName() << endl;
    player.showHand();
    cout << endl;

    // Test 6: wantsToHit (Player default behavior)
    cout << "TEST 6: Player wantsToHit() - Should return false" << endl;
    bool wantsHit = player.wantsToHit();
    cout << "Player wants to hit: " << (wantsHit ? "true" : "false") << endl << endl;

    // Test 7: clearHand
    cout << "TEST 7: Clear Hand" << endl;
    cout << "Hand before clear: ";
    player.showHand();
    player.clearHand();
    cout << "Hand after clear: ";
    player.showHand();
    cout << endl;

    // Test 8: Dealer Constructor
    cout << "TEST 8: Dealer Constructor" << endl;
    Dealer dealer;
    cout << "Dealer name: " << dealer.getName() << endl << endl;

    // Test 9: Add Cards to Dealer
    cout << "TEST 9: Adding Cards to Dealer" << endl;
    dealer.addCard(6);
    dealer.addCard(9);
    cout << "Added cards: 6, 9" << endl;
    dealer.showHand();
    cout << endl;

    // Test 10: Dealer wantsToHit (hand value < 17)
    cout << "TEST 10: Dealer wantsToHit() - Hand value is 15, should be true" << endl;
    bool dealerWantsHit = dealer.wantsToHit();
    cout << "Dealer wants to hit: " << (dealerWantsHit ? "true" : "false") << endl << endl;

    // Test 11: Add card to dealer to exceed 17
    cout << "TEST 11: Dealer wantsToHit() - After adding card" << endl;
    dealer.addCard(5);
    cout << "Added card: 5 (Total is now " << dealer.getHandValue() << ")" << endl;
    dealerWantsHit = dealer.wantsToHit();
    cout << "Dealer wants to hit: " << (dealerWantsHit ? "true" : "false") << endl;
    dealer.showHand();
    cout << endl;

    // Test 12: Dealer showHand with hideFirstCard
    cout << "TEST 12: Dealer showHand() with hideFirstCard=true" << endl;
    dealer.showHand(true);
    cout << endl;

    // Test 13: Test with Aces (11 value)
    cout << "TEST 13: Test Hand with Aces" << endl;
    Player acePlayer("Ace Tester");
    acePlayer.addCard(11);  // Ace
    acePlayer.addCard(10);  // Face card
    cout << "Added cards: Ace(11), 10" << endl;
    cout << "Hand value (should be 21): " << acePlayer.getHandValue() << endl;
    acePlayer.showHand();
    cout << endl;

    // Test 14: Test with Multiple Aces
    cout << "TEST 14: Test Hand with Multiple Aces" << endl;
    Player multiAcePlayer("Multi Ace");
    multiAcePlayer.addCard(11);  // Ace
    multiAcePlayer.addCard(11);  // Ace
    multiAcePlayer.addCard(9);   // 9
    cout << "Added cards: Ace(11), Ace(11), 9" << endl;
    cout << "Hand value (should be 21): " << multiAcePlayer.getHandValue() << endl;
    multiAcePlayer.showHand();
    cout << endl;

    // Test 15: Test Bust Scenario
    cout << "TEST 15: Test Bust Scenario" << endl;
    Player bustPlayer("Bust Tester");
    bustPlayer.addCard(10);
    bustPlayer.addCard(10);
    bustPlayer.addCard(5);
    cout << "Added cards: 10, 10, 5" << endl;
    cout << "Hand value (should be 25 - BUST): " << bustPlayer.getHandValue() << endl;
    bustPlayer.showHand();
    cout << endl;

    // Test 16: showHand with hideFirstCard for Player
    cout << "TEST 16: Player showHand() with hideFirstCard=true" << endl;
    bustPlayer.showHand(true);
    cout << endl;

    cout << "========================================" << endl;
    cout << "     ALL TESTS COMPLETED SUCCESSFULLY!" << endl;
    cout << "========================================" << endl;

    return 0;
}